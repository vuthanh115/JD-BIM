								Height="30"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT17}"
								IsChecked="{Binding GeneralSetting.ShouldSpliceAtTwoPositions}" />
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Row="3"
						Grid.Column="1"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER7}">
