									IsEnabled="{Binding ElementName=rbFramingFloorManual, Path=IsChecked}" />
							</DockPanel>
							<RadioButton
								Height="30"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT20}"
								IsChecked="{Binding GeneralSetting.FramingFloorSelectionType, Converter={StaticResource ConverterEnumToBoolean}, ConverterParameter={x:Static models:EnumFramingFloorSelectionType.Framing}}" />
							<RadioButton
								Height="30"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT21}"
								IsChecked="{Binding GeneralSetting.FramingFloorSelectionType, Converter={StaticResource ConverterEnumToBoolean}, ConverterParameter={x:Static models:EnumFramingFloorSelectionType.Floor}}" />
							<DockPanel>
								<RadioButton
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT22}"
