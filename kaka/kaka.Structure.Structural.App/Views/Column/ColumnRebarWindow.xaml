                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFAAAAAA" />
                                    <Setter Property="Background" Value="#15000000" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StarterBarSetting.Leftward}" Value="True">
                                            <Setter Property="BorderThickness" Value="2.5" />
                                            <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                            <Setter Property="Background" Value="#35D32F2F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button
                                Style="{StaticResource ButtonIcon}"
                                Command="{Binding StarterBarSetting.LeftwardCommand}">
                                <ContentControl.Content>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding StarterBarSetting.LeftwardImage}" />
                                </ContentControl.Content>
                            </Button>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="2"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFAAAAAA" />
                                    <Setter Property="Background" Value="#15000000" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StarterBarSetting.Rightward}" Value="True">
                                            <Setter Property="BorderThickness" Value="2.5" />
                                            <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                            <Setter Property="Background" Value="#35D32F2F" />
