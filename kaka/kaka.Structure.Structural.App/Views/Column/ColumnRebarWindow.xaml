    </TabControl>
  </Grid>

  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
    </i:EventTrigger>

    <i:EventTrigger EventName="Closed">
      <i:InvokeCommandAction Command="{Binding WindowClosedCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>

