                                        <DataTrigger Binding="{Binding StarterBarSetting.IsCenterActive}" Value="True">
                                            <Setter Property="BorderThickness" Value="2.5" />
                                            <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                            <Setter Property="Background" Value="#35D32F2F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button
                                Style="{StaticResource ButtonIcon}"
                                Command="{Binding StarterBarSetting.InwardOutwardCommand}">
