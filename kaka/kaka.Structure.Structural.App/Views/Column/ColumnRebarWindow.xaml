									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									Text="{Binding GeneralSetting.CoefficientAnchorageLength}" />
							</DockPanel>
							<CheckBox
								Height="30"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT9}"
								IsChecked="{Binding GeneralSetting.ShouldCrankRebarAtSplice}" />
							<DockPanel
								Height="30">
								<!--Unknown connection ID: 16-->
								<CheckBox
									Name="ckbGroupRebar"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT10}"
									IsChecked="{Binding GeneralSetting.ShouldGroupRebarSameNumber}" />
								<ComboBox
									Width="150"
									HorizontalAlignment="Right"
									IsEnabled="{Binding ElementName=ckbGroupRebar, Path=IsChecked}"
									ItemsSource="{Binding RebarParameters}"
									SelectedItem="{Binding GeneralSetting.GroupParameterName}" />
							</DockPanel>
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Column="1"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER5}">
