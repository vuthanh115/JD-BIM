                                    Data="{DynamicResource Round}"
                                    Fill="#FF800000"
                                    Stretch="Uniform" />
                            </Button>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</TabItem>

      <!-- TAB 4 -->
      <TabItem
	      Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition />
					</Grid.RowDefinitions>
					<GroupBox
						Grid.Row="0"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER1}">
						<StackPanel>
							<DockPanel
								Height="30"
								Margin="0,0,0,5">
								<!--Unknown connection ID: 14-->
								<RadioButton
									Name="rbHeadLockByLength"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT1}"
									GroupName="HeadLockByLength"
									IsChecked="{Binding GeneralSetting.IsHeadLockByLength}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									IsEnabled="{Binding ElementName=rbHeadLockByLength, Path=IsChecked}"
									Text="{Binding GeneralSetting.HeadHookLength, Converter={StaticResource ConverterFootToMm}, ConverterParameter=0}" />
							</DockPanel>
							<DockPanel
								Height="30">
								<!--Unknown connection ID: 15-->
								<RadioButton
									Name="rbHeadLockByFactor"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT2}"
									GroupName="HeadLockByLength"
									IsChecked="{Binding GeneralSetting.IsHeadLockByLength, Converter={StaticResource ConverterBoolReverse}}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									IsEnabled="{Binding ElementName=rbHeadLockByFactor, Path=IsChecked}"
									Text="{Binding GeneralSetting.HeadHookFactor}" />
							</DockPanel>
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Row="1"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER2}">
						<StackPanel>
							<RadioButton
								Height="25"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT3}"
								IsChecked="{Binding GeneralSetting.HasHeadLock}" />
							<RadioButton
								Height="25"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT4}"
								IsChecked="{Binding GeneralSetting.HasHeadLock, Converter={StaticResource ConverterBoolReverse}}" />
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Row="2"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER3}">
						<StackPanel>
							<CheckBox
								Height="25"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT5}"
								IsChecked="{Binding GeneralSetting.ShouldSetLevelForRebar}" />
							<CheckBox
								Height="25"
								Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT6}"
								IsChecked="{Binding GeneralSetting.ShouldSetPartitionForRebar}" />
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Row="3"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER4}">
						<StackPanel>
							<DockPanel
								Height="30"
								Margin="0,0,0,5">
								<TextBlock
									Text="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT7}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									Text="{Binding GeneralSetting.CoefficientLapLength}" />
							</DockPanel>
							<DockPanel
								Height="30">
								<TextBlock
									Text="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT8}" />
