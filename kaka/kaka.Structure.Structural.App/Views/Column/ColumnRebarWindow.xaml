							<DockPanel
								Height="30">
								<!--Unknown connection ID: 18-->
								<RadioButton
									Name="rbFramingFloorManual"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT18}"
									IsChecked="{Binding GeneralSetting.FramingFloorSelectionType, Converter={StaticResource ConverterEnumToBoolean}, ConverterParameter={x:Static models:EnumFramingFloorSelectionType.Manual}}" />
								<Button
									Width="100"
									HorizontalAlignment="Right"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT19}"
