								<TextBlock
									Text="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT11}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									Text="{Binding GeneralSetting.MaxE, Converter={StaticResource ConverterFootToMm}, ConverterParameter=0}" />
							</DockPanel>
							<DockPanel>
								<TextBlock
									Text="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT12}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									Text="{Binding GeneralSetting.CoefficientHdE}" />
							</DockPanel>
						</StackPanel>
					</GroupBox>
					<GroupBox
						Grid.Row="1"
						Grid.RowSpan="2"
						Grid.Column="1"
						Header="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_HEADER6}">
						<StackPanel>
							<DockPanel>
								<!--Unknown connection ID: 17-->
								<RadioButton
									Name="rbSpliceAtBottom"
									Content="{DynamicResource COLUMREBAR2_COLUMNREBARVIEW_COMMON_TEXT13}"
									GroupName="SplicePosition"
									IsChecked="{Binding GeneralSetting.ShouldSpliceAtBottom}" />
								<TextBox
									Width="100"
									HorizontalAlignment="Right"
									Style="{StaticResource TextBoxNumberOnly}"
									IsEnabled="{Binding ElementName=rbSpliceAtBottom, Path=IsChecked}"
