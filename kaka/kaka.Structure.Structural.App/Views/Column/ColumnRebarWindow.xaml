                                <ContentControl.Content>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding StarterBarSetting.RightwardImage}" />
                                </ContentControl.Content>
                            </Button>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="50"
                            Height="50"
                            VerticalAlignment="Bottom"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFAAAAAA" />
                                    <Setter Property="Background" Value="#15000000" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StarterBarSetting.Backward}" Value="True">
                                            <Setter Property="BorderThickness" Value="2.5" />
                                            <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                            <Setter Property="Background" Value="#35D32F2F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button
                                Style="{StaticResource ButtonIcon}"
                                Command="{Binding StarterBarSetting.BackwardCommand}">
                                <ContentControl.Content>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding StarterBarSetting.BackwardImage}" />
                                </ContentControl.Content>
                            </Button>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="50"
                            Height="50"
                            VerticalAlignment="Top"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFAAAAAA" />
                                    <Setter Property="Background" Value="#15000000" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StarterBarSetting.Frontward}" Value="True">
                                            <Setter Property="BorderThickness" Value="2.5" />
                                            <Setter Property="BorderBrush" Value="#FFD32F2F" />
                                            <Setter Property="Background" Value="#35D32F2F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button
                                Style="{StaticResource ButtonIcon}"
                                Command="{Binding StarterBarSetting.FrontwardCommand}">
                                <ContentControl.Content>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding StarterBarSetting.FrontwardImage}" />
                                </ContentControl.Content>
                            </Button>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="50"
                            Height="50"
                            CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#FFAAAAAA" />
                                    <Setter Property="Background" Value="#15000000" />
