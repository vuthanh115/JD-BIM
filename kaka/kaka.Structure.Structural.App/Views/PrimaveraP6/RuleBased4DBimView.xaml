<controls:MetroWindow
    x:Class="kaka.Structure.Structural.App.Views.PrimaveraP6.RuleBased4DBimView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    mc:Ignorable="d"
    Title="KAKA — Rule-Based 4D BIM Engine (Navisworks Sets + P6 CPM Auto-Attach)"
    Width="1020"
    Height="680"
    MinHeight="550"
    MinWidth="800"
    Background="#F8FAFC"
    Foreground="#0F172A"
    GlowBrush="#2563EB"
    NonActiveGlowBrush="#94A3B8"
    WindowTitleBrush="#0F172A"
    NonActiveWindowTitleBrush="#334155"
    WindowStartupLocation="CenterScreen">

  <FrameworkElement.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </FrameworkElement.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <!-- 0: Header & Executive Value Banner -->
      <RowDefinition Height="Auto" />
      <!-- 1: 4D Tasks DataGrid -->
      <RowDefinition Height="*" />
      <!-- 2: Output Settings Card -->
      <RowDefinition Height="Auto" />
      <!-- 3: Footer Buttons & Status -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 0: Header & Executive Value Banner -->
    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
              <TextBlock Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Text="BEXEL ALTERNATIVE" />
            </Border>
            <TextBlock FontSize="16"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Text="{Binding ProjectName, StringFormat='Dự án: {0}'}" />
          </StackPanel>
          <TextBlock FontSize="12"
                     Foreground="#64748B"
                     Margin="0,4,0,0"
                     Text="Quy trình 4D Rule-based: Navisworks Search Sets XML + Quantification Duration + P6 CPM Logic + Auto-Attach TimeLiner" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0284C7" CornerRadius="16" Padding="12,5" Margin="0,0,6,0">
            <TextBlock Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                       Text="{Binding TotalTasks, StringFormat='{}{0} Công Tác 4D'}" />
          </Border>
          <Border Background="#10B981" CornerRadius="16" Padding="12,5" Margin="0,0,6,0">
            <TextBlock Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                       Text="{Binding TotalLogicLinks, StringFormat='{}{0} CPM Links'}" />
          </Border>
          <Border Background="#8B5CF6" CornerRadius="16" Padding="12,5" Margin="0,0,6,0">
            <TextBlock Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                       Text="{Binding TotalSearchSets, StringFormat='{}{0} Search Sets'}" />
          </Border>
          <Border Background="#EF4444" CornerRadius="16" Padding="12,5">
            <TextBlock Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                       Text="{Binding CriticalTasksCount, StringFormat='{}{0} Critical'}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1: 4D Tasks DataGrid -->
    <Border Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#334155"
                   Margin="0,0,0,8"
                   Text="Bảng Phân Bổ Công Tác 4D BIM, Định Mức Năng Suất &amp; Đường Găng CPM:" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Tasks}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column"
                  RowHeight="30"
                  Background="#FFFFFF">
          <DataGrid.Resources>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#F8FAFC" />
              <Setter Property="Foreground" Value="#475569" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Padding" Value="8,6" />
              <Setter Property="BorderBrush" Value="#E2E8F0" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.Resources>

          <DataGrid.Columns>
            <!-- 1. Bộ môn -->
            <DataGridTextColumn Header="Bộ Môn"
                                Binding="{Binding Discipline}"
                                Width="85" />

            <!-- 2. Search Set Name (Khớp Navisworks) -->
            <DataGridTextColumn Header="Navisworks Search Set"
                                Binding="{Binding SearchSetName}"
                                Width="180">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="#0369A1" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- 3. Mã Activity P6 -->
            <DataGridTextColumn Header="P6 Activity ID"
                                Binding="{Binding TaskCode}"
                                Width="140" />

            <!-- 4. Khối lượng 3D -->
            <DataGridTextColumn Header="Khối Lượng 3D"
                                Binding="{Binding Quantity, StringFormat='{}{0:N1}'}"
                                Width="95">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- 5. ĐVT -->
            <DataGridTextColumn Header="ĐVT"
                                Binding="{Binding Unit}"
                                Width="50">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- 6. Định mức ca -->
            <DataGridTextColumn Header="Định Mức/Ngày"
                                Binding="{Binding ProductivityRate, StringFormat='{}{0:N0}'}"
                                Width="95">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- 7. Duration (ngày) -->
            <DataGridTextColumn Header="Thời Lượng"
                                Binding="{Binding DurationDays, StringFormat='{}{0} ngày'}"
                                Width="85">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="FontWeight" Value="Bold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- 8. Predecessors (CPM Logic) -->
            <DataGridTextColumn Header="Quan Hệ CPM (Predecessor)"
                                Binding="{Binding PredecessorsDisplay}"
                                Width="170" />

            <!-- 9. Đường găng CPM -->
            <DataGridTemplateColumn Header="Đường Găng" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCritical}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Float: 5d" />
                          <Setter Property="Foreground" Value="#64748B" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                              <Setter Property="Text" Value="CRITICAL" />
                              <Setter Property="Foreground" Value="#DC2626" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- 2: Output Settings Card -->
    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="14"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,10"
                   Text="Cấu Hình Xuất Trọn Gói 4D BIM Suite (Navisworks Manage + Primavera P6)" />

        <!-- Output Directory -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="Thư mục xuất tệp tin:"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="#334155" />

          <TextBox Grid.Column="1"
                   Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                   Margin="8,0" />

          <Button Grid.Column="2"
                  Content="Chọn thư mục..."
                  Command="{Binding BrowseOutputDirectoryCommand}"
                  Padding="14,4"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  Cursor="Hand" />
        </Grid>

        <!-- Options checkboxes in 2 columns -->
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <CheckBox Content="1. Sinh Navisworks Search Sets XML chuẩn hóa (.xml)"
                      IsChecked="{Binding ExportSearchSetsXml}"
                      FontWeight="SemiBold"
                      Foreground="#0284C7"
                      Margin="0,0,0,6" />

            <CheckBox Content="2. Sinh TimeLiner Auto-Attach Rules XML (.xml)"
                      IsChecked="{Binding ExportTimeLinerRulesXml}"
                      FontWeight="SemiBold"
                      Foreground="#0284C7"
                      Margin="0,0,0,6" />

            <CheckBox Content="3. Sinh TimeLiner Tasks CSV có sẵn Field Mapping (.csv)"
                      IsChecked="{Binding ExportTimeLinerCsv}"
                      FontWeight="SemiBold"
                      Foreground="#0284C7" />
          </StackPanel>

          <StackPanel Grid.Column="1">
            <CheckBox Content="4. Sinh Primavera P6 CPM Schedule (.xer có bảng TASKPRED)"
                      IsChecked="{Binding ExportP6CpmXer}"
                      FontWeight="SemiBold"
                      Foreground="#16A34A"
                      Margin="0,0,0,6" />

            <CheckBox Content="5. Sinh Tài liệu SOP Hướng Dẫn 5 Bước 4D BIM (.md)"
                      IsChecked="{Binding ExportWorkflowGuide}"
                      FontWeight="SemiBold"
                      Foreground="#7C3AED"
                      Margin="0,0,0,6" />

            <CheckBox Content="Mở thư mục đích sau khi hoàn tất"
                      IsChecked="{Binding OpenFolderAfterExport}"
                      Margin="0,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 3: Footer Buttons & Status -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 Foreground="#475569"
                 FontSize="12"
                 TextTrimming="CharacterEllipsis" />

      <Button Grid.Column="1"
              Content="🚀 Xuất Trọn Bộ 4D BIM (Navisworks + P6)"
              Command="{Binding Export4DSuiteCommand}"
              Background="#2563EB"
              Foreground="#FFFFFF"
              FontWeight="Bold"
              FontSize="13"
              Padding="24,9"
              BorderThickness="0"
              Margin="0,0,10,0"
              Cursor="Hand">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
          </Style>
        </Button.Resources>
      </Button>

      <Button Grid.Column="2"
              Content="Đóng"
              Command="{Binding CloseCommand}"
              Background="#E2E8F0"
              Foreground="#0F172A"
              FontSize="13"
              Padding="18,9"
              BorderThickness="0"
              Cursor="Hand">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
          </Style>
        </Button.Resources>
      </Button>
    </Grid>
  </Grid>
</controls:MetroWindow>
