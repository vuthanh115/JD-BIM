<controls:MetroWindow
    x:Class="kaka.Structure.Structural.App.Views.PrimaveraP6.ExportP6ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    mc:Ignorable="d"
    Title="KAKA — Xuất Tiến Độ WBS &amp; Hoạt Động Sang Primavera P6 (.XER / .CSV)"
    Width="940"
    Height="640"
    MinHeight="500"
    MinWidth="740"
    Background="#F1F5F9"
    Foreground="#0F172A"
    GlowBrush="#0284C7"
    NonActiveGlowBrush="#94A3B8"
    WindowTitleBrush="#0F172A"
    NonActiveWindowTitleBrush="#334155"
    WindowStartupLocation="CenterScreen">

  <FrameworkElement.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </FrameworkElement.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <!-- 0: Header Project Info Card -->
      <RowDefinition Height="Auto" />
      <!-- 1: DataGrid Summary Card -->
      <RowDefinition Height="*" />
      <!-- 2: Output Settings Card -->
      <RowDefinition Height="Auto" />
      <!-- 3: Footer Buttons & Status -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 0: Header Project Info Card -->
    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="#0F172A"
                     Text="{Binding ProjectName, StringFormat='Dự án: {0}'}" />
          <TextBlock FontSize="12"
                     Foreground="#64748B"
                     Margin="0,4,0,0"
                     Text="{Binding ModelTitle, StringFormat='Tập tin mô hình: {0}'}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0284C7"
                  CornerRadius="16"
                  Padding="14,6"
                  Margin="0,0,8,0">
            <TextBlock Foreground="#FFFFFF"
                       FontWeight="Bold"
                       FontSize="13"
                       Text="{Binding TotalWbsNodes, StringFormat='{}{0} WBS Nodes'}" />
          </Border>
          <Border Background="#10B981"
                  CornerRadius="16"
                  Padding="14,6">
            <TextBlock Foreground="#FFFFFF"
                       FontWeight="Bold"
                       FontSize="13"
                       Text="{Binding TotalActivities, StringFormat='{}{0} Activities'}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1: DataGrid Summary Card -->
    <Border Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Link Options Row -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"
                       Text="Bảng Phân Bổ Cấu Kiện Kết Cấu &amp; Kiến Trúc ➔ WBS &amp; P6 (BIM 4D/5D)" />
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IncludeLinkedModels}"
                      Content="Quét các mô hình Revit Link"
                      FontWeight="SemiBold"
                      Foreground="#0284C7"
                      VerticalAlignment="Center"
                      ToolTip="Tự động trích xuất cấu kiện Kiến trúc (Tường gạch, Cửa, Trần, Mái, Ốp lát...) từ các file Revit Link được chọn." />
          </Grid>

          <!-- Individual Link Selection Pills / Checkboxes -->
          <Border Margin="0,6,0,0"
                  Padding="10,6"
                  Background="#F8FAFC"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  CornerRadius="6">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IncludeLinkedModels}" Value="True" />
                      <Condition Binding="{Binding HasAvailableLinks}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left"
                         Text="Chọn file Link cần bóc tách:"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Foreground="#475569"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />

              <ItemsControl ItemsSource="{Binding AvailableLinks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}"
                              Margin="0,2,16,2"
                              VerticalAlignment="Center"
                              ToolTip="{Binding FilePath}">
                      <CheckBox.Content>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12"
                                   Foreground="#1E293B" />
                      </CheckBox.Content>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding WbsItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  Background="#FFFFFF"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  FontSize="12">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#0F172A" />
              <Setter Property="Foreground" Value="#FFFFFF" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="10,6" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="BorderBrush" Value="#334155" />
              <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
          </DataGrid.ColumnHeaderStyle>

          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="MinHeight" Value="28" />
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <DataGridTextColumn Header="Bộ Môn"
                                Binding="{Binding Discipline}"
                                Width="95">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Mã WBS (P6)"
                                Binding="{Binding WbsCode}"
                                Width="120" />

            <DataGridTextColumn Header="Hạng Mục Công Việc"
                                Binding="{Binding ComponentName}"
                                Width="220" />

            <DataGridTextColumn Header="Cấu Kiện Revit"
                                Binding="{Binding ElementCount, StringFormat='{}{0:N0}'}"
                                Width="100">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Số Tasks"
                                Binding="{Binding TaskCount, StringFormat='{}{0} tasks'}"
                                Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Thời Lượng"
                                Binding="{Binding DurationDays, StringFormat='{}{0} ngày'}"
                                Width="85">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Tài Nguyên P6 (Primary Resource)"
                                Binding="{Binding PrimaryResource}"
                                Width="*" />

            <DataGridTextColumn Header="Mã Chi Phí"
                                Binding="{Binding CostAccount}"
                                Width="110" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- 2: Output Settings Card -->
    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="14"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,10"
                   Text="Tùy Chọn Định Dạng Xuất Primavera P6" />

        <!-- P6 Database Sync Option (Tiếng Việt có dấu 100%) -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Content="Đồng bộ vào P6 Database (.db)"
                    FontWeight="SemiBold"
                    Foreground="#0284C7"
                    IsChecked="{Binding SyncToP6Database}" />

          <TextBox Grid.Column="1"
                   Text="{Binding P6DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                   Margin="8,0"
                   IsEnabled="{Binding SyncToP6Database}" />

          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseP6DatabaseCommand}"
                  IsEnabled="{Binding SyncToP6Database}"
                  Padding="14,4"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  Cursor="Hand" />
        </Grid>

        <!-- XER File Option -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Content="Xuất file Native P6 (.xer)"
                    FontWeight="SemiBold"
                    IsChecked="{Binding ExportToXer}" />

          <TextBox Grid.Column="1"
                   Text="{Binding XerFilePath, UpdateSourceTrigger=PropertyChanged}"
                   Margin="8,0"
                   IsEnabled="{Binding ExportToXer}" />

          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseXerFileCommand}"
                  IsEnabled="{Binding ExportToXer}"
                  Padding="14,4"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  Cursor="Hand" />
        </Grid>

        <!-- CSV File Option -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Content="Xuất bảng tính P6 (.csv)"
                    FontWeight="SemiBold"
                    IsChecked="{Binding ExportToCsv}" />

          <TextBox Grid.Column="1"
                   Text="{Binding CsvFilePath, UpdateSourceTrigger=PropertyChanged}"
                   Margin="8,0"
                   IsEnabled="{Binding ExportToCsv}" />

          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseCsvFileCommand}"
                  IsEnabled="{Binding ExportToCsv}"
                  Padding="14,4"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  Cursor="Hand" />
        </Grid>

        <!-- Navisworks 4D Rule-Based Option (Bexel workflow) -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Content="Navisworks 4D Search Sets (.xml)"
                    FontWeight="SemiBold"
                    Foreground="#059669"
                    ToolTip="Tạo bộ Search Sets XML &amp; Timeliner Rules tự động map 3D sang P6 như quy trình Bexel Manager"
                    IsChecked="{Binding ExportNavisworks4D}" />

          <TextBox Grid.Column="1"
                   Text="{Binding NavisworksSetsPath, UpdateSourceTrigger=PropertyChanged}"
                   Margin="8,0"
                   IsEnabled="{Binding ExportNavisworks4D}" />

          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseNavisworksSetsCommand}"
                  IsEnabled="{Binding ExportNavisworks4D}"
                  Padding="14,4"
                  Background="#F1F5F9"
                  BorderBrush="#CBD5E1"
                  Cursor="Hand" />
        </Grid>

        <!-- Open folder checkbox -->
        <CheckBox Content="Mở thư mục đích sau khi xuất thành công"
                  IsChecked="{Binding OpenFolderAfterExport}"
                  Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- 3: Footer Buttons & Status -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 VerticalAlignment="Center"
                 Foreground="#475569"
                 FontSize="12"
                 TextTrimming="CharacterEllipsis" />

      <Button Grid.Column="1"
              Content="Xuất sang Primavera P6"
              Command="{Binding ExportCommand}"
              Background="#0284C7"
              Foreground="#FFFFFF"
              FontWeight="Bold"
              FontSize="13"
              Padding="24,8"
              BorderThickness="0"
              Margin="0,0,10,0"
              Cursor="Hand">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
          </Style>
        </Button.Resources>
      </Button>

      <Button Grid.Column="2"
              Content="Đóng"
              Command="{Binding CloseCommand}"
              Background="#E2E8F0"
              Foreground="#0F172A"
              FontSize="13"
              Padding="18,8"
              BorderThickness="0"
              Cursor="Hand">
        <Button.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
          </Style>
        </Button.Resources>
      </Button>
    </Grid>
  </Grid>
</controls:MetroWindow>
