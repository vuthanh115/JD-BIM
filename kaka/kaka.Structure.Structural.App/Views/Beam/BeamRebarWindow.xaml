<mah:MetroWindow
    x:Class="kaka.Structure.Structural.App.Views.Beam.BeamRebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    mc:Ignorable="d"
    Title="Thép dầm - Kaka Structure"
    Width="940"
    Height="720"
    MinHeight="600"
    MinWidth="850"
    WindowStartupLocation="CenterScreen">

  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
      
      <!-- Style cho badge số tròn (1) .. (7) -->
      <Style x:Key="BadgeNumberStyle" TargetType="Border">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="BorderBrush" Value="#2B579A"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="#EBF2FA"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#2B579A"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="SectionItemHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#222222"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <!-- HEADER -->
      <RowDefinition Height="Auto"/>
      <!-- MAIN BODY -->
      <RowDefinition Height="*"/>
      <!-- FOOTER -->
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>

    <!-- 1. HEADER -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="A. Bạn hãy điền số lượng và đường kính thép" 
                 FontSize="15" FontWeight="Bold" Foreground="#1E395B" Margin="0,0,0,4"/>
      <TextBlock Text="Cấu hình số lượng thanh, chủng loại đường kính và bước rải đai theo đúng mặt cắt tiết diện." 
                 FontSize="12" Foreground="Gray"/>
      <Separator Margin="0,6,0,0"/>
    </StackPanel>

    <!-- 2. MAIN BODY (LEFT: 2D PREVIEW, RIGHT: INPUTS) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT: CANVAS MẶT CẮT TIẾT DIỆN -->
      <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Dropdown chọn dầm đang xem -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="Dầm đang chọn:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" DisplayMemberPath="Mark" Width="180"/>
          </StackPanel>

          <!-- Canvas vẽ mặt cắt -->
          <Canvas x:Name="canvasCrossSection" Grid.Row="1" ClipToBounds="True" Background="White" Margin="6"/>
        </Grid>
      </Border>

      <!-- RIGHT: CONTROLS (1) TO (7) + ADVANCED -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
        <StackPanel>

          <!-- 1. THÉP GIA CƯỜNG LỚP TRÊN -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="1" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép gia cường lớp trên, điền 0 nếu không tạo" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <CheckBox IsChecked="{Binding Setting.HasTopExtraL1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding QuantitiesWithZero}" SelectedItem="{Binding Setting.TopExtraL1Quantity}" Width="65" IsEnabled="{Binding Setting.HasTopExtraL1}"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.TopExtraL1Type}" Width="140" IsEnabled="{Binding Setting.HasTopExtraL1}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 2. THÉP CHÍNH LỚP 1 (TRÊN) -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="2" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép chính lớp 1 (chạy suốt trên)" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <ComboBox ItemsSource="{Binding Quantities2To8}" SelectedItem="{Binding Setting.TopMainQuantity}" Width="65"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.TopMainType}" Width="140"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 3. THÉP GIA CƯỜNG TOP LỚP 2 -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="3" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép gia cường top lớp 2" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <CheckBox IsChecked="{Binding Setting.HasTopExtraL2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Quantities1To8}" SelectedItem="{Binding Setting.TopExtraL2Quantity}" Width="65" IsEnabled="{Binding Setting.HasTopExtraL2}"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.TopExtraL2Type}" Width="140" IsEnabled="{Binding Setting.HasTopExtraL2}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 4. THÉP GIA CƯỜNG BOT LỚP 2 -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="4" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép gia cường bot lớp 2" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <CheckBox IsChecked="{Binding Setting.HasBottomExtraL2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Quantities1To8}" SelectedItem="{Binding Setting.BottomExtraL2Quantity}" Width="65" IsEnabled="{Binding Setting.HasBottomExtraL2}"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.BottomExtraL2Type}" Width="140" IsEnabled="{Binding Setting.HasBottomExtraL2}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 5. THÉP ĐAI -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="5" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thông tin thép đai" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              
              <StackPanel Margin="30,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Loại đai:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox ItemsSource="{Binding AvailableStirrupTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.StirrupType}" Width="120"/>
                </StackPanel>

                <!-- Radio 1: A1 - L -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                  <RadioButton Content="A1:" IsChecked="{Binding Setting.IsModeA1L}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Text="{Binding Setting.StirrupA1}" Width="60" IsEnabled="{Binding Setting.IsModeA1L}"/>
                  <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,16,0" Foreground="Gray"/>
                  <TextBlock Text="L:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Text="{Binding Setting.StirrupL}" Width="70" IsEnabled="{Binding Setting.IsModeA1L}"/>
                  <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <!-- Radio 2: A1 - A2 -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <RadioButton Content="A1:" IsChecked="{Binding Setting.IsModeA1A2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Text="{Binding Setting.StirrupA1}" Width="60" IsEnabled="{Binding Setting.IsModeA1A2}"/>
                  <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,16,0" Foreground="Gray"/>
                  <TextBlock Text="A2:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox Text="{Binding Setting.StirrupA2}" Width="70" IsEnabled="{Binding Setting.IsModeA1A2}"/>
                  <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="Gray"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 6. THÉP CHÍNH LỚP DƯỚI -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="6" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép chính lớp dưới (chạy suốt đáy)" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <ComboBox ItemsSource="{Binding Quantities2To8}" SelectedItem="{Binding Setting.BottomMainQuantity}" Width="65"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.BottomMainType}" Width="140"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 7. THÉP GIA CƯỜNG LỚP DƯỚI -->
          <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{StaticResource BadgeNumberStyle}"><TextBlock Text="7" Style="{StaticResource BadgeTextStyle}"/></Border>
                <TextBlock Text="Điền thép gia cường lớp dưới (bụng giữa nhịp)" Style="{StaticResource SectionItemHeader}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <CheckBox IsChecked="{Binding Setting.HasBottomExtraL1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding QuantitiesWithZero}" SelectedItem="{Binding Setting.BottomExtraL1Quantity}" Width="65" IsEnabled="{Binding Setting.HasBottomExtraL1}"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="8,0,8,0" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.BottomExtraL1Type}" Width="140" IsEnabled="{Binding Setting.HasBottomExtraL1}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- EXPANDER CẤU TẠO BỔ SUNG -->
          <Expander Header="B. Cấu tạo mở rộng (Lớp bảo vệ, Thép sườn, Móc neo)" IsExpanded="False" Margin="0,0,0,8">
            <StackPanel Margin="10">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Lớp bảo vệ (Cover):" Width="140" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Setting.Cover}" Width="70"/>
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Thép giá sườn (h ≥ 700mm):" IsChecked="{Binding Setting.HasSideRebar}" Width="180" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Quantities2To8}" SelectedItem="{Binding Setting.SideRebarQuantity}" Width="50" IsEnabled="{Binding Setting.HasSideRebar}"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <ComboBox ItemsSource="{Binding AvailableBarTypes}" DisplayMemberPath="Name" SelectedItem="{Binding Setting.SideRebarType}" Width="120" IsEnabled="{Binding Setting.HasSideRebar}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Bẻ móc neo 90° tại gối biên:" IsChecked="{Binding Setting.HasHooks}" Width="180" VerticalAlignment="Center"/>
                <TextBlock Text="Móc trên:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding Setting.TopHookLength}" Width="55" IsEnabled="{Binding Setting.HasHooks}"/>
                <TextBlock Text="Móc dưới:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Text="{Binding Setting.BottomHookLength}" Width="55" IsEnabled="{Binding Setting.HasHooks}"/>
                <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Expander>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 3. FOOTER BUTTONS -->
    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Bố trí thép" Command="{Binding RunCommand}" 
                Width="120" Height="34" Margin="0,0,10,0"
                Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        <Button Content="Hủy bỏ" Command="{Binding CancelCommand}" 
                Width="90" Height="34" Cursor="Hand"/>
      </StackPanel>
    </Border>
  </Grid>
</mah:MetroWindow>
