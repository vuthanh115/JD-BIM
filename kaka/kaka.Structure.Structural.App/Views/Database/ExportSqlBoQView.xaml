<controls:MetroWindow
    x:Class="kaka.Structure.Structural.App.Views.Database.ExportSqlBoQView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    mc:Ignorable="d"
    Title="KAKA — Trích Xuất Dữ Liệu BoQ / SQL từ Mô Hình Revit"
    Width="860"
    Height="600"
    MinHeight="480"
    MinWidth="680"
    Background="#F1F5F9"
    Foreground="#0F172A"
    GlowBrush="#0284C7"
    NonActiveGlowBrush="#94A3B8"
    WindowTitleBrush="#0F172A"
    NonActiveWindowTitleBrush="#334155"
    WindowStartupLocation="CenterScreen">

  <FrameworkElement.Resources>
    <!-- Base styles for high-contrast, crisp modern appearance -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </FrameworkElement.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <!-- 0: Header Project Info Card -->
      <RowDefinition Height="Auto" />
      <!-- 1: DataGrid Summary Card -->
      <RowDefinition Height="*" />
      <!-- 2: Output Settings Card -->
      <RowDefinition Height="Auto" />
      <!-- 3: Footer Buttons & Status -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 0: Header Project Info Card -->
    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="#0F172A"
                     Text="{Binding ProjectName, StringFormat='Dự án: {0}'}" />
          <TextBlock FontSize="12"
                     Foreground="#64748B"
                     Margin="0,4,0,0"
                     Text="{Binding ModelTitle, StringFormat='Tập tin mô hình: {0}'}" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="#0284C7"
                CornerRadius="16"
                Padding="14,6"
                VerticalAlignment="Center">
          <TextBlock Foreground="#FFFFFF"
                     FontWeight="Bold"
                     FontSize="13"
                     Text="{Binding TotalElements, StringFormat='Tổng: {0:N0} cấu kiện'}" />
        </Border>
      </Grid>
    </Border>

    <!-- 1: DataGrid Summary Card -->
    <Border Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tổng hợp cấu kiện theo đề mục chuẩn Mindmap"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="#1E293B"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Categories}"
                  Background="#FFFFFF"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F8FAFC"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  FontSize="12">

          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#F1F5F9" />
              <Setter Property="Foreground" Value="#1E293B" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="BorderBrush" Value="#CBD5E1" />
              <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
          </DataGrid.ColumnHeaderStyle>

          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Foreground" Value="#0F172A" />
              <Setter Property="Height" Value="28" />
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <DataGridTextColumn Header="Mã Đề mục" Width="100" Binding="{Binding CategoryCode}" FontWeight="SemiBold" />
            <DataGridTextColumn Header="Tên Cấu kiện" Width="180" Binding="{Binding CategoryName}" />
            <DataGridTextColumn Header="Số lượng" Width="80" Binding="{Binding Count, StringFormat='{}{0:N0}'}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Foreground" Value="#0F172A" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Thể tích (m³)" Width="110" Binding="{Binding TotalVolumeM3, StringFormat='{}{0:N3}'}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Foreground" Value="#0F172A" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Ván khuôn (m²)" Width="110" Binding="{Binding TotalAreaM2, StringFormat='{}{0:N2}'}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Foreground" Value="#0F172A" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Cốt thép (kg)" Width="*" Binding="{Binding TotalWeightKg, StringFormat='{}{0:N2}'}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Foreground" Value="#0F172A" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- 2: Output Settings Card -->
    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Cấu hình xuất dữ liệu"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="#1E293B"
                   Margin="0,0,0,10" />

        <!-- DB File Option -->
        <Grid Margin="0,3,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0"
                    Content="Ghi vào SQLite Database (.db)"
                    IsChecked="{Binding ExportToDb}"
                    FontWeight="SemiBold"
                    Foreground="#0F172A" />
          <TextBox Grid.Column="1"
                   Text="{Binding DbFilePath, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding ExportToDb}"
                   Height="30" />
          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseDbFileCommand}"
                  IsEnabled="{Binding ExportToDb}"
                  Margin="8,0,0,0"
                  Height="30"
                  Background="#F1F5F9"
                  Foreground="#1E293B"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  Cursor="Hand" />
        </Grid>

        <!-- SQL Script Option -->
        <Grid Margin="0,3,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0"
                    Content="Xuất file script SQL (.sql)"
                    IsChecked="{Binding ExportToSql}"
                    FontWeight="SemiBold"
                    Foreground="#0F172A" />
          <TextBox Grid.Column="1"
                   Text="{Binding SqlFilePath, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding ExportToSql}"
                   Height="30" />
          <Button Grid.Column="2"
                  Content="Chọn..."
                  Command="{Binding BrowseSqlFileCommand}"
                  IsEnabled="{Binding ExportToSql}"
                  Margin="8,0,0,0"
                  Height="30"
                  Background="#F1F5F9"
                  Foreground="#1E293B"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  Cursor="Hand" />
        </Grid>

        <!-- Post Action -->
        <CheckBox Content="Mở thư mục đích sau khi xuất thành công"
                  IsChecked="{Binding OpenFolderAfterExport}"
                  Foreground="#334155"
                  Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- 3: Footer Buttons & Status -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Status text -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#0284C7"
                   FontWeight="SemiBold"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Width="140"
                Height="36"
                Margin="0,0,10,0"
                Content="Xuất dữ liệu"
                Command="{Binding ExportCommand}"
                Background="#0284C7"
                Foreground="#FFFFFF"
                FontWeight="Bold"
                FontSize="13"
                BorderThickness="0"
                Cursor="Hand" />
        <Button Width="90"
                Height="36"
                Content="Đóng"
                Command="{Binding CloseCommand}"
                Background="#E2E8F0"
                Foreground="#1E293B"
                FontWeight="SemiBold"
                FontSize="13"
                BorderThickness="0"
                Cursor="Hand"
                IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</controls:MetroWindow>
